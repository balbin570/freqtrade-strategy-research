
name: Altcoins 90-Day Backtest

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  backtest:
    runs-on: ubuntu-latest
    timeout-minutes: 90

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install pandas numpy

      - name: Run altcoin backtest
        run: python backtest_altcoins_90d.py

      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: altcoins-90d-results
          path: backtest_results_altcoins/
          if-no-files-found: warn
